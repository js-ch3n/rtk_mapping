<launch>
    <!-- GNSS Conversion Node
         Converts raw RTK NavSatFix (lat/lon/alt) into zero-based odometry
         for FAST_LIO RTK mapping. -->

    <arg name="input_rtk_topic"    default="/rtk_fix" />
    <arg name="output_odom_topic"  default="/rtk_odom" />
    <arg name="world_frame_id"     default="odom" />
    <arg name="child_frame_id"     default="base_link" />
    <arg name="publish_tf"         default="true" />
    <arg name="reset_on_jump"      default="true" />
    <arg name="jump_threshold"     default="50.0" />
    <arg name="heading_min_speed"  default="0.5" />
    <arg name="fix_status_min"     default="0" />
    <arg name="antenna_offset_x"   default="0.0" />
    <arg name="antenna_offset_y"   default="0.0" />
    <arg name="antenna_offset_z"   default="0.0" />

    <node pkg="gnss_conversion" type="gnss_conversion_node"
          name="gnss_conversion" output="screen">
        <param name="input_rtk_topic"    value="$(arg input_rtk_topic)" />
        <param name="output_odom_topic"  value="$(arg output_odom_topic)" />
        <param name="world_frame_id"     value="$(arg world_frame_id)" />
        <param name="child_frame_id"     value="$(arg child_frame_id)" />
        <param name="publish_tf"         value="$(arg publish_tf)" />
        <param name="reset_on_jump"      value="$(arg reset_on_jump)" />
        <param name="jump_threshold"     value="$(arg jump_threshold)" />
        <param name="heading_min_speed"  value="$(arg heading_min_speed)" />
        <param name="fix_status_min"     value="$(arg fix_status_min)" />
        <param name="antenna_offset_x"   value="$(arg antenna_offset_x)" />
        <param name="antenna_offset_y"   value="$(arg antenna_offset_y)" />
        <param name="antenna_offset_z"   value="$(arg antenna_offset_z)" />
    </node>
</launch>
